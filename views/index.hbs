<html>
  <head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="src/css/app.css" rel="stylesheet" />
    <link href="src/css/login.css" rel="stylesheet" />
    <link href="src/css/signup.css" rel="stylesheet" />
    <title>Cloud1</title>
  </head>
  <body>
    <div class="wraperContainer">
      <!-- welcome page -->
      <div class="welcomePage">
        <div class="welcomePageConts">
          <div class="welcomeSubConts">
            <div class="loadingScreen">
              <img
                id="cloud1LId"
                class="cloud1LClass"
                src="/assets/logos/cloud1-rebrand/cloud1-logo-rebrand-mix-orange.png"
              />
            </div>
            <div style="display:none;">
              <img
                src="/assets/icons/loading.gif"
                width="100"
                style="filter: brightness(0) invert(1);"
              />
              <div>
                <p>Welcome to Cloud1</p>
                <p>A community based on different culture all across the global</p>
              </div>
            </div>
          </div>

        </div>
      </div>
      {{! Navibar section }}
      <div class="naviBar">
        <span class="leftsider">
          <span class="menuBtn">
            <img class="burgerBtn" src="/assets/icons/menu.png" />
          </span>

          <!--Hidden menu -->
          <div class="toggleMenu" style="display: none;">
            <div class="toggleMenuConts">
              <div id="profilePrev" class="linkBtn">
                <div class="prlusrIcon">
                  <span class="prlusriconFilr">
                    <img
                      src="/assets/icons/user (1).png"
                      width="15"
                      style="filter: brightness(0) invert(1);"
                    />
                  </span>

                </div>

                <span>
                  <p class="usrPrlusername">Guest</p>
                  <p class="usrPrlEmail">cloud1guest@gmail.com</p>
                </span>
              </div>

              <p class="linkBtn" id="drppflBtn">
                <span>
                  <img
                    class="drpprflIcon"
                    src="/assets/icons/user (1).png"
                  /></span>
                My Profile</p>
              <p class="linkBtn" id="drpmychtsBtn">
                <span>
                  <img
                    class="drpmchtsIcon"
                    src="/assets/icons/chat.png"
                  /></span>
                My Chats</p>
              <p class="linkBtn" id="drpexprBtn">
                <span>
                  <img
                    class="drphpspIcon"
                    src="/assets/icons/compass.png"
                  /></span>
                Explore</p>
              <p class="linkBtn" id="drpdaymdBtn">
                <span>
                  <img
                    class="drpdaymdIcon"
                    src="/assets/icons/brightness.png"
                  /></span>
                Daylight Mode</p>
              <p class="linkBtn" id="drpstngsBtn">
                <span>
                  <img
                    class="drpstgsIcon"
                    src="/assets/icons/setting.png"
                  /></span>
                Settings</p>

              <p class="linkBtn" id="drpdwnldBtn">
                <span>
                  <img
                    class="drpdwnldIcon"
                    src="/assets/icons/downloads.png"
                  /></span>
                Download App</p>
              <p class="linkBtn" id="drphpspBtn">
                <span class="dropsLinks">
                  <img
                    class="sphpiconcl"
                    src="/assets/icons/speech-bubble.png"
                  /></span>
                Help & Support
              </p>
              <p class="linkBtn" id="drplgoutBtn">
                <span>
                  <img
                    class="drplgtIcon"
                    src="/assets/icons/logout.png"
                  /></span>
                Logout</p>
              <br />
              <br />
              <br />
              <p class="linkBtn" id="dropsFooterCl">Cloud1 2025</p>
              <p class="linkBtn" id="dropsFootVers">Version 1.0.0 - All rights
                reserved.
              </p>
            </div>
          </div>

          <span class="cloud1L">
            <img
              id="cloud1LId"
              class="cloud1LClass"
              src="/assets/logos/cloud1-rebrand/cloud1-logo-rebrand-mix-orange.png"
            />
          </span>

        </span>

        <span class="rightsider">
          <span>
            <button class="loginBtn">Log In</button>
          </span>
          <span class="notifications">
            <img src="/assets/icons/notification.png" class="fticonclass" />
          </span>

          <span class="profileMenu">
            <img src="/assets/icons/user (1).png" class="profileiconcl" />
          </span>
        </span>
      </div>

      {{! Contents section }}
      <div class="contents">
        <div class="contentsSec">

          <img
            src="/assets/icons/loading.gif"
            width="20"
            style="filter: brightness(0) invert(1);"
          />
        </div>
      </div>

      {{! Footer }}
      <div class="footerdrawer">

        <div class="ftdwrhndle">
          <img src="/assets/icons/caret-down.png" class="ftdwr" /></div>
        <div class="dwrcntnts">
          <div class="homeSec">
            <img src="/assets/icons/home.png" class="ftdwr_a" />
            <span>Home section</span>
          </div>
          <div class="librarySec">
            <img src="/assets/icons/book.png" class="ftdwr_a" />
            <span>Cultural Library/Archive</span>
          </div>
          <div class="searchSec">
            <img src="/assets/icons/search.png" class="ftdwr_a" />
            <span>Search</span>
          </div>
        </div>
      </div>
      {{!       <div class="footer">

        <p>somethingh</p>
      </div> }}
    </div>

    <script defer src="dist/js/app.js"></script>
    <script defer src="dist/js/login.js"></script>
    <script defer src="dist/js/signup.js"></script>
    <script defer src="dist/js/profile.js"></script>
    <script defer src="dist/js/navibar.js"></script>
    <script defer src="dist/js/auto_filer.js"></script>
    <script defer src="dist/js/subcontents.js"></script>
    <script defer src="dist/js/welcome.mgs.js"></script>

  </body>
</html>